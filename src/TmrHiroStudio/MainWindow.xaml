<Window x:Class="TmrHiroStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TmrHiroStudio" Height="720" Width="980" MinHeight="640" MinWidth="850"
        WindowStartupLocation="CenterScreen" Background="#F4F6F7" FontFamily="Microsoft JhengHei UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9E1E4" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="TmrHiroStudio" FontSize="22" FontWeight="SemiBold" Foreground="#1F4650" />
                    <TextBlock Text="Tmr-Hiro ADV System 資源整合工具" Foreground="#65777D" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="PAC  ·  GRD  ·  SRP  ·  VAR" Foreground="#246B75" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="#D9E1E4">
            <TabItem Header="PAC 封包">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="解包 PAC" Padding="10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="PAC 檔案／資料夾" />
                                <TextBox x:Name="PacExtractInput" Grid.Row="0" Grid.Column="1" />
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="選擇檔案" Click="PacExtractFile_Click" />
                                    <Button Content="選擇資料夾" Click="PacExtractFolder_Click" />
                                </StackPanel>
                                <Label Grid.Row="1" Grid.Column="0" Content="輸出資料夾" />
                                <TextBox x:Name="PacExtractOutput" Grid.Row="1" Grid.Column="1" />
                                <Button Grid.Row="1" Grid.Column="2" Content="瀏覽" Click="PacExtractOutput_Click" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="6,5" Foreground="#65777D" Text="資料夾模式會批次處理其中的 PAC；每個封包各自建立子資料夾，並產生版本／檔名 manifest。" TextWrapping="Wrap" />
                                <Button Grid.Row="2" Grid.Column="2" Content="開始解包" Click="PacUnpackEnhanced_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="回封 PAC" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="解包資料夾" />
                                <TextBox x:Name="PacPackInput" Grid.Row="0" Grid.Column="1" />
                                <Button Grid.Row="0" Grid.Column="2" Content="瀏覽" Click="PacPackInput_Click" />
                                <Label Grid.Row="1" Grid.Column="0" Content="PAC 版本" />
                                <ComboBox x:Name="PacVersion" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="4" SelectedIndex="0">
                                    <ComboBoxItem Content="自動（優先使用 manifest）" Tag="0" />
                                    <ComboBoxItem Content="Version 1" Tag="1" />
                                    <ComboBoxItem Content="Version 2" Tag="2" />
                                </ComboBox>
                                <Button Grid.Row="1" Grid.Column="2" Content="選擇輸出 PAC" Click="PacPack_Click" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,5" Foreground="#65777D" Text="回封時會保留原始索引順序、Shift-JIS 名稱位元組及版本。沒有 manifest 時才依選項建立新封包。" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="GRD 圖像">
                <StackPanel Margin="14">
                    <TextBlock Text="GRD → PNG" FontWeight="SemiBold" FontSize="15" Foreground="#1F4650" Margin="4,4,4,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="GRD 檔案／資料夾" />
                        <TextBox x:Name="GrdExtractInput" Grid.Row="0" Grid.Column="1" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="選擇檔案" Click="GrdExtractFile_Click" />
                            <Button Content="選擇資料夾" Click="GrdExtractFolder_Click" />
                        </StackPanel>
                        <Label Grid.Row="1" Grid.Column="0" Content="PNG 輸出資料夾" />
                        <TextBox x:Name="GrdExtractOutput" Grid.Row="1" Grid.Column="1" />
                        <Button Grid.Row="1" Grid.Column="2" Content="瀏覽" Click="GrdExtractOutput_Click" />
                    </Grid>
                    <Button Content="批次解碼 GRD → PNG" Width="190" HorizontalAlignment="Left" Margin="4,8,4,22" Click="GrdExtractEnhanced_Click" />
                    <Separator Margin="0,4,0,16" />
                    <TextBlock Text="PNG → GRD" FontWeight="SemiBold" FontSize="15" Foreground="#1F4650" Margin="4,4,4,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="PNG 檔案／資料夾" />
                        <TextBox x:Name="GrdBuildInput" Grid.Row="0" Grid.Column="1" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="選擇檔案" Click="GrdBuildFile_Click" />
                            <Button Content="選擇資料夾" Click="GrdBuildFolder_Click" />
                        </StackPanel>
                        <Label Grid.Row="1" Grid.Column="0" Content="GRD 輸出資料夾" />
                        <TextBox x:Name="GrdBuildOutput" Grid.Row="1" Grid.Column="1" />
                        <Button Grid.Row="1" Grid.Column="2" Content="瀏覽" Click="GrdBuildOutput_Click" />
                    </Grid>
                    <Button Content="批次建立 PNG → GRD" Width="190" HorizontalAlignment="Left" Margin="4,8,4,8" Click="GrdBuildEnhanced_Click" />
                    <TextBlock Margin="6,10" Foreground="#65777D" Text="GRD 匯出會建立 .grd.json 中繼資料；回封優先保留原始畫布、位置與色彩深度。新圖像會使用 RLE 壓縮，並保留 GRD 的版本低位元組。" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="SRP／VAR 腳本">
                <StackPanel Margin="14">
                    <TextBlock Text="二進位資源 → UTF-8 文字" FontWeight="SemiBold" FontSize="15" Foreground="#1F4650" Margin="4,4,4,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="SRP／VAR 檔案／資料夾" />
                        <TextBox x:Name="ScriptExportInput" Grid.Row="0" Grid.Column="1" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="選擇檔案" Click="ScriptExportFile_Click" />
                            <Button Content="選擇資料夾" Click="ScriptExportFolder_Click" />
                        </StackPanel>
                        <Label Grid.Row="1" Grid.Column="0" Content="文字輸出資料夾" />
                        <TextBox x:Name="ScriptExportOutput" Grid.Row="1" Grid.Column="1" />
                        <Button Grid.Row="1" Grid.Column="2" Content="瀏覽" Click="ScriptExportOutput_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="4,5,4,7" VerticalAlignment="Center">
                        <Label Content="文字編碼" Padding="4" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScriptExportEncoding" Width="190" Margin="2,0,12,0"
                                  SelectedIndex="0" SelectionChanged="ScriptExportEncoding_SelectionChanged"
                                  ToolTip="選擇 SRP／VAR Data 的文字編碼；選項會寫入 TXT 標頭，回封時自動沿用。">
                            <ComboBoxItem Content="CP932（Shift-JIS）" Tag="CP932" />
                            <ComboBoxItem Content="GBK／CP936（簡體中文）" Tag="GBK" />
                            <ComboBoxItem Content="UTF-8" Tag="UTF8" />
                            <ComboBoxItem Content="RAW（只匯出位元組）" Tag="RAW" />
                            <ComboBoxItem Content="自動偵測（僅供參考）" Tag="AUTO" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,18">
                        <Button Content="SRP → TXT" Click="SrpExportMapped_Click" />
                        <Button Content="VAR → TXT" Click="VarExportMapped_Click" />
                        <Button Content="SRP + VAR → TXT" Click="BothExport_Click" ToolTip="遞迴匯出所有 SRP 與 VAR，並保留子資料夾結構。" />
                    </StackPanel>
                    <Separator Margin="0,4,0,14" />
                    <TextBlock Text="UTF-8 文字 → 二進位資源" FontWeight="SemiBold" FontSize="15" Foreground="#1F4650" Margin="4,4,4,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="TXT 檔案／資料夾" />
                        <TextBox x:Name="ScriptBuildInput" Grid.Row="0" Grid.Column="1" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="選擇檔案" Click="ScriptBuildFile_Click" />
                            <Button Content="選擇資料夾" Click="ScriptBuildFolder_Click" />
                        </StackPanel>
                        <Label Grid.Row="1" Grid.Column="0" Content="二進位輸出資料夾" />
                        <TextBox x:Name="ScriptBuildOutput" Grid.Row="1" Grid.Column="1" />
                        <Button Grid.Row="1" Grid.Column="2" Content="瀏覽" Click="ScriptBuildOutput_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
                        <Button Content="TXT → SRP" Click="SrpBuildFixed_Click" />
                        <Button Content="TXT → VAR" Click="VarBuildFixed_Click" />
                        <Button Content="TXT → SRP + VAR" Click="BothBuildFixed_Click" ToolTip="同一資料夾內的 .srp.txt 與 .var.txt 一起編譯；全部解析成功後才輸出。" />
                    </StackPanel>
                    <TextBlock Margin="6,10" Foreground="#65777D" Text="SRP 依完整 32-bit opcode 分類訊息、旁白與選項；選項前綴及跳轉標籤會保留。TXT v4 檔案本身以 UTF-8 讀取，Encoding 標頭只決定 SRP Data 的編碼（例如 GBK）。TXT → SRP + VAR 會先完成整批解析，再一次提交輸出。" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="執行記錄" Padding="6" Margin="0,10,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="清除記錄" HorizontalAlignment="Right" Margin="4,5,4,0" Click="ClearLog_Click" />
                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#FBFCFC" />
            </DockPanel>
        </GroupBox>

        <DockPanel Grid.Row="3" LastChildFill="False" VerticalAlignment="Center">
            <TextBlock Text="不會修改原始輸入檔；建議先備份遊戲資源。" Foreground="#65777D" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="就緒" Foreground="#246B75" VerticalAlignment="Center" Margin="10,0,8,0" />
                <ProgressBar x:Name="BusyProgress" Width="92" Height="10" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
                <TextBlock Text="TmrHiroStudio 1.0.5" Foreground="#65777D" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
